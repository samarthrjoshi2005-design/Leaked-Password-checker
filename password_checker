import sqlite3
import hashlib
import re

DB_NAME = "breach.db"

# Sample "leaked passwords" - normally this would be a huge downloaded wordlist
SAMPLE_BREACHED_PASSWORDS = [
    "123456", "password", "qwerty", "password123", "letmein",
    "admin", "welcome", "iloveyou", "monkey", "abc123"
]


# ---------- STEP 1: Set up the database ----------
def setup_database():
    """Creates the database and table if they don't already exist."""
    conn = sqlite3.connect(DB_NAME)
    cur = conn.cursor()
    cur.execute("""
        CREATE TABLE IF NOT EXISTS breached_passwords (
            id INTEGER PRIMARY KEY,
            password_hash TEXT UNIQUE NOT NULL
        )
    """)
    conn.commit()
    conn.close()


# ---------- STEP 2: Load sample breached passwords into the database ----------
def load_sample_data():
    """Hashes and inserts sample breached passwords (only runs once)."""
    conn = sqlite3.connect(DB_NAME)
    cur = conn.cursor()

    for pwd in SAMPLE_BREACHED_PASSWORDS:
        hashed = hashlib.sha1(pwd.encode()).hexdigest()
        cur.execute(
            "INSERT OR IGNORE INTO breached_passwords (password_hash) VALUES (?)",
            (hashed,)
        )

    conn.commit()
    conn.close()


# ---------- STEP 3: Check if a password is breached ----------
def is_breached(password):
    """Hashes the given password and checks if it exists in the database."""
    hashed = hashlib.sha1(password.encode()).hexdigest()

    conn = sqlite3.connect(DB_NAME)
    cur = conn.cursor()
    cur.execute("SELECT 1 FROM breached_passwords WHERE password_hash = ?", (hashed,))
    result = cur.fetchone()
    conn.close()

    return result is not None


# ---------- STEP 4: Score password strength ----------
def strength_score(password):
    """Returns a score (0-6) and a label describing password strength."""
    score = 0

    if len(password) >= 8:
        score += 1
    if len(password) >= 12:
        score += 1
    if re.search(r'[a-z]', password):
        score += 1
    if re.search(r'[A-Z]', password):
        score += 1
    if re.search(r'\d', password):
        score += 1
    if re.search(r'[^A-Za-z0-9]', password):
        score += 1
    if re.search(r'(.)\1{2,}', password):  # 3+ repeated characters in a row
        score -= 1

    score = max(score, 0)  # never go below 0

    labels = {
        0: "Very Weak",
        1: "Very Weak",
        2: "Weak",
        3: "Fair",
        4: "Good",
        5: "Strong",
        6: "Very Strong"
    }

    return score, labels[score]


# ---------- STEP 5: Combine everything into one check ----------
def check_password(password):
    """Runs both the breach check and strength check, prints results."""
    breached = is_breached(password)
    score, label = strength_score(password)

    print("\n--- Result ---")
    print(f"Password checked : {password}")
    print(f"Breached         : {'⚠️  YES - found in breach database' if breached else '✅ No - not found'}")
    print(f"Strength         : {label} ({score}/6)")
    print("--------------\n")


# ---------- MAIN PROGRAM ----------
def main():
    setup_database()
    load_sample_data()

    print("=== Leaked Password Checker ===")
    print("Type 'quit' to exit.\n")

    while True:
        password = input("Enter a password to check: ")
        if password.lower() == "quit":
            print("Goodbye!")
            break
        check_password(password)


if __name__ == "__main__":
    main()
